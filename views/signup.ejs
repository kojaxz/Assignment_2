<%- include('partials/navbar') %>

<div class="container d-flex flex-column align-items-center vh-100" style="padding-top: 25vh;">
    <h1 class="mb-4">Create User</h1>
    <form action="/submitUser" method="post" class="d-flex flex-column align-items-center w-100" style="max-width: 300px;">
        <input name="username" type="text" placeholder="Username" class="form-control mb-3">
        <input name="email" type="email" placeholder="Email" class="form-control mb-3">
        <input name="password" type="password" placeholder="Password" class="form-control mb-3">
        <button class="btn btn-primary rounded-pill px-3 w-100">Submit</button>
    </form>
</div>

<%- include('partials/footer') %>